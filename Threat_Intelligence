    "# 3. Normalize and mask text, segment Chinese, and record the cleaning flow.\n",
    "URL = re.compile(r\"(?:https?://|www\\.)[^\\s<>\\u3000-\\u303f\\uff00-\\uffef\\u3400-\\u9fff]+\", re.I)\n",
    "EMAIL = re.compile(r\"[\\w.+-]+@[\\w.-]+\\.[A-Za-z]{2,}\", re.ASCII)\n",
    "HANDLE = re.compile(r\"@[\\w\\u3400-\\u9fff-]+\")\n",
    "LONG_NUMBER = re.compile(r\"(?<!\\d)\\d{7,}(?!\\d)\")\n",
    "HTML = re.compile(r\"<[^>]{1,150}>\")\n",
    "MASK_RULES = {\"URL\": URL, \"Email\": EMAIL, \"Handle\": HANDLE, \"Long number\": LONG_NUMBER}\n",
    "LABELS = {\n",
    "    \"0\": 0, \"0.0\": 0, \"negative\": 0, \"neg\": 0, \"负面\": 0, \"负向\": 0, \"差评\": 0,\n",
    "    \"1\": 1, \"1.0\": 1, \"positive\": 1, \"pos\": 1, \"正面\": 1, \"正向\": 1, \"好评\": 1,\n",
    "}\n",
    "LABELS.update({str(k).strip().casefold(): v for k, v in LABEL_OVERRIDES.items()})\n",
    "if not set(LABELS.values()).issubset({0, 1}):\n",
    "    raise ValueError(\"LABEL_OVERRIDES must map to 0 (negative) or 1 (positive).\")\n",
    "\n",
    "def normalize_text(value):\n",
    "    value = unicodedata.normalize(\"NFKC\", str(value)).lower()\n",
    "    return HTML.sub(\" \", value)\n",
    "\n",
    "def clean_text(value):\n",
    "    for pattern in MASK_RULES.values():\n",
    "        value = pattern.sub(\" \", value)\n",
    "    return \" \".join(value.split())\n",
    "\n",
    "def tokenize(value):\n",
    "    return [\n",
    "        token.strip() for token in jieba.lcut(value, HMM=True)\n",
    "        if token.strip() and any(ch.isalnum() for ch in token)\n",
    "    ]\n",
    "\n",
    "normalized = raw[text_col].fillna(\"\").map(normalize_text)\n",
    "mask_stats = pd.DataFrame([\n",
    "    {\"pattern\": name, \"raw_documents_with_match\": int(normalized.map(lambda s: bool(pattern.search(s))).sum())}\n",
    "    for name, pattern in MASK_RULES.items()\n",
    "])\n",
    "mask_stats.to_csv(OUT / \"privacy_pattern_audit.csv\", index=False)\n",
    "mapped = raw[label_col].astype(\"string\").str.strip().str.casefold().map(LABELS)\n",
    "if not mapped.notna().any():\n",
    "    raise ValueError(\"No binary labels recognized. Check the raw label counts and set LABEL_OVERRIDES.\")\n",
    "data = pd.DataFrame({\"source_row\": np.arange(len(raw)), \"label\": mapped, \"text\": normalized.map(clean_text)})\n",
    "audit_rows = [{\"stage\": \"Raw input\", \"retained\": len(data), \"removed_at_stage\": 0}]\n",
    "\n",
    "def record_stage(stage, size):\n",
    "    audit_rows.append({\"stage\": stage, \"retained\": size, \"removed_at_stage\": audit_rows[-1][\"retained\"] - size})\n",
    "\n",
    "data = data.loc[data[\"label\"].notna()].copy()\n",
    "data[\"label\"] = data[\"label\"].astype(int)\n",
    "record_stage(\"Valid binary label\", len(data))\n",
    "data = data.loc[data[\"text\"].str.len() > 0].copy()\n",
    "record_stage(\"Nonempty after normalization and masking\", len(data))\n",
    "data[\"tokens\"] = data[\"text\"].map(tokenize)\n",
    "data = data.loc[data[\"tokens\"].map(len) > 0].copy()\n",
    "record_stage(\"At least one retained token\", len(data))\n",
    "data[\"segmented\"] = data[\"tokens\"].map(\" \".join)\n",
    "conflicts = data.groupby(\"segmented\", sort=False)[\"label\"].transform(\"nunique\") > 1\n",
    "data = data.loc[~conflicts].copy()\n",
    "record_stage(\"Conflicting token sequences excluded\", len(data))\n",
    "data = data.drop_duplicates(\"segmented\", keep=\"first\").copy()\n",
    "record_stage(\"Exact token duplicates removed\", len(data))\n",
    "data[\"word_count\"] = data[\"tokens\"].map(len)\n",
    "data[\"char_count\"] = data[\"text\"].str.len()\n",
    "\n",
    "if data[\"label\"].nunique() != 2 or data[\"label\"].value_counts().min() < 10:\n",
    "    raise ValueError(\"Each class needs at least 10 distinct labeled reviews after cleaning.\")\n",
    "clean_count = len(data)\n",
    "if MAX_ROWS is not None and len(data) > MAX_ROWS:\n",
    "    if MAX_ROWS < 30:\n",
    "        raise ValueError(\"Set MAX_ROWS to at least 30 or None.\")\n",
    "    data, _ = train_test_split(data, train_size=MAX_ROWS, stratify=data[\"label\"], random_state=SEED)\n",
    "record_stage(\"Selected modeling corpus\", len(data))\n",
    "data = data.reset_index(drop=True)\n",
    "if data[\"label\"].nunique() != 2 or data[\"label\"].value_counts().min() < 10:\n",
    "    raise ValueError(\"The modeling cap removed too many minority examples. Increase MAX_ROWS.\")\n",
    "\n",
    "audit = pd.DataFrame(audit_rows)\n",
