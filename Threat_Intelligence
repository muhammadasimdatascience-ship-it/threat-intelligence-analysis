    "                                    stratify=lda_train[\"label\"], random_state=SEED)\n",
    "topic_stop = [\"的\", \"了\", \"是\", \"我\", \"也\", \"就\", \"都\", \"在\", \"和\", \"有\", \"又\", \"很\", \"还\"]\n",
    "count_vectorizer = CountVectorizer(\n",
    "    tokenizer=str.split, token_pattern=None, lowercase=False, min_df=2,\n",
    "    max_df=.95, max_features=5000, stop_words=topic_stop\n",
    ")\n",
    "topic_train_matrix = count_vectorizer.fit_transform(lda_train[\"segmented\"]).tocsr()\n",
    "topic_test_matrix = count_vectorizer.transform(sets[\"test\"][\"segmented\"]).tocsr()\n",
