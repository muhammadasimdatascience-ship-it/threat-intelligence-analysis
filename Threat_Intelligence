    "    (\"TextCNN\", TextCNN),\n",
    "    (\"GRU\", lambda: RecurrentClassifier(\"GRU\")),\n",
    "    (\"BiLSTM\", lambda: RecurrentClassifier(\"BiLSTM\")),\n",
    "]:\n",
    "    hist, val_f1, epoch, pred, scores = train_neural(name, factory)\n",
