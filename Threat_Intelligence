    "# 7. Define neural models and masked/padded sequence handling.\n",
    "from torch import nn\n",
    "from torch.nn.utils.rnn import pack_padded_sequence\n",
    "from torch.utils.data import DataLoader, TensorDataset\n",
    "\n",
    "def make_loader(name, shuffle=False):\n",
    "    seq, length = encoded[name]\n",
    "    ds = TensorDataset(torch.from_numpy(seq), torch.from_numpy(length), torch.from_numpy(y[name]))\n",
    "    return DataLoader(\n",
    "        ds, batch_size=BATCH_SIZE, shuffle=shuffle, num_workers=0,\n",
    "        generator=torch.Generator().manual_seed(SEED) if shuffle else None,\n",
    "        pin_memory=device.type == \"cuda\"\n",
    "    )\n",
    "\n",
    "class TextCNN(nn.Module):\n",
    "    def __init__(self):\n",
    "        super().__init__()\n",
    "        self.embedding = nn.Embedding(vocab_size, 64, padding_idx=PAD_ID)\n",
    "        self.convs = nn.ModuleList(nn.Conv1d(64, 64, width, padding=width // 2) for width in (3, 5, 7))\n",
    "        self.head = nn.Sequential(nn.Dropout(.30), nn.Linear(192, 2))\n",
    "\n",
    "    def forward(self, seq, lengths):\n",
    "        x = self.embedding(seq).transpose(1, 2)\n",
    "        valid = torch.arange(seq.shape[1], device=seq.device)[None, :] < lengths.to(seq.device)[:, None]\n",
    "        features = [torch.relu(conv(x)).masked_fill(~valid[:, None, :], -torch.inf).amax(dim=2)\n",
    "                    for conv in self.convs]\n",
    "        return self.head(torch.cat(features, dim=1))\n",
    "\n",
    "class RecurrentClassifier(nn.Module):\n",
    "    def __init__(self, kind):\n",
    "        super().__init__()\n",
    "        self.embedding = nn.Embedding(vocab_size, 64, padding_idx=PAD_ID)\n",
    "        self.kind = kind\n",
    "        if kind == \"GRU\":\n",
    "            self.rnn = nn.GRU(64, 64, batch_first=True)\n",
    "        elif kind == \"BiLSTM\":\n",
    "            self.rnn = nn.LSTM(64, 64, batch_first=True, bidirectional=True)\n",
    "        else:\n",
    "            raise ValueError(f\"Unknown recurrent architecture: {kind}\")\n",
    "        self.head = nn.Sequential(nn.Dropout(.30), nn.Linear(64 if kind == \"GRU\" else 128, 2))\n",
    "\n",
    "    def forward(self, seq, lengths):\n",
    "        packed = pack_padded_sequence(self.embedding(seq), lengths.cpu(), batch_first=True, enforce_sorted=False)\n",
    "        _, state = self.rnn(packed)\n",
    "        if self.kind == \"GRU\":\n",
    "            features = state[-1]\n",
    "        else:\n",
    "            hidden, _ = state\n",
    "            features = torch.cat([hidden[-2], hidden[-1]], dim=1)\n",
    "        return self.head(features)\n",
    "\n",
    "train_class_counts = np.bincount(y[\"train\"], minlength=2)\n",
    "weights = torch.tensor(len(y[\"train\"]) / (2.0 * train_class_counts), dtype=torch.float32, device=device)\n",
    "loss_fn = nn.CrossEntropyLoss(weight=weights)"
