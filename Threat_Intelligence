    "# 5. TF-IDF for classic models and train-only token IDs for neural models.\n",
    "from sklearn.feature_extraction.text import TfidfVectorizer\n",
    "\n",
    "tfidf = TfidfVectorizer(\n",
    "    tokenizer=str.split, token_pattern=None, lowercase=False, ngram_range=(1, 2),\n",
    "    min_df=2, max_features=40_000, sublinear_tf=True, dtype=np.float32\n",
    ")\n",
    "X_train = tfidf.fit_transform(sets[\"train\"][\"segmented\"])\n",
    "X_val = tfidf.transform(sets[\"validation\"][\"segmented\"])\n",
    "X_test = tfidf.transform(sets[\"test\"][\"segmented\"])\n",
    "y = {name: part[\"label\"].to_numpy(dtype=np.int64) for name, part in sets.items()}\n",
    "\n",
    "token_freq = Counter(token for doc in sets[\"train\"][\"tokens\"] for token in doc)\n",
    "vocab = {token: i + 2 for i, (token, _) in enumerate(token_freq.most_common(MAX_VOCAB - 2))}\n",
    "PAD_ID, UNK_ID = 0, 1\n",
    "vocab_size = len(vocab) + 2\n",
    "\n",
    "def encode_batch(documents):\n",
    "    sequences = np.full((len(documents), MAX_TOKENS), PAD_ID, dtype=np.int64)\n",
    "    lengths = np.zeros(len(documents), dtype=np.int64)\n",
    "    for i, tokens in enumerate(documents):\n",
    "        ids = [vocab.get(token, UNK_ID) for token in tokens[:MAX_TOKENS]]\n",
    "        sequences[i, :len(ids)] = ids\n",
    "        lengths[i] = len(ids)\n",
    "    return sequences, lengths\n",
    "\n",
    "encoded = {name: encode_batch(part[\"tokens\"]) for name, part in sets.items()}\n",
    "repr_stats = pd.DataFrame([\n",
    "    {\"split\": name, \"documents\": len(part), \"tfidf_features\": X_train.shape[1],\n",
    "     \"tokens_truncated_docs\": int(part[\"word_count\"].gt(MAX_TOKENS).sum()),\n",
    "     \"unknown_token_rate\": round(float((encoded[name][0] == UNK_ID).sum() / encoded[name][1].sum()), 4)}\n",
    "    for name, part in sets.items()\n",
    "])\n",
    "repr_stats.to_csv(OUT / \"representation_stats.csv\", index=False)\n",
    "display(repr_stats)\n",
    "print(\"TF-IDF matrix shapes:\", X_train.shape, X_val.shape, X_test.shape)\n",
