    "# 8. Fit each architecture and select its checkpoint on validation macro F1.\n",
    "import time\n",
    "\n",
    "@torch.inference_mode()\n",
    "def neural_predictions(model, loader):\n",
    "    model.eval()\n",
    "    scores = []\n",
    "    for seq, lengths, _ in loader:\n",
    "        logits = model(seq.to(device), lengths)\n",
    "        scores.append(torch.softmax(logits, dim=1)[:, 1].cpu().numpy())\n",
    "    scores = np.concatenate(scores)\n",
    "    return (scores >= .5).astype(int), scores\n",
    "\n",
    "def train_neural(name, make_model):\n",
    "    torch.manual_seed(SEED)\n",
    "    if device.type == \"cuda\":\n",
    "        torch.cuda.manual_seed_all(SEED)\n",
    "    model = make_model().to(device)\n",
    "    train_loader = make_loader(\"train\", shuffle=True)\n",
    "    val_loader = make_loader(\"validation\")\n",
    "    optimizer = torch.optim.AdamW(model.parameters(), lr=.001)\n",
    "    history, best_state = [], None\n",
    "    best_f1, best_epoch, stale = -1., 0, 0\n",
    "    for epoch in range(1, EPOCHS + 1):\n",
    "        start = time.perf_counter()\n",
    "        model.train()\n",
    "        total_loss, total_weight = 0., 0.\n",
    "        for seq, lengths, labels in train_loader:\n",
    "            seq, labels = seq.to(device), labels.to(device)\n",
    "            optimizer.zero_grad(set_to_none=True)\n",
    "            loss = loss_fn(model(seq, lengths), labels)\n",
    "            loss.backward()\n",
    "            nn.utils.clip_grad_norm_(model.parameters(), 1.0)\n",
    "            optimizer.step()\n",
    "            batch_weight = weights[labels].sum().item()\n",
    "            total_loss += loss.item() * batch_weight\n",
    "            total_weight += batch_weight\n",
    "        val_pred, _ = neural_predictions(model, val_loader)\n",
    "        val_f1 = f1_score(y[\"validation\"], val_pred, average=\"macro\", zero_division=0)\n",
    "        history.append({\"model\": name, \"epoch\": epoch, \"training_loss\": total_loss / total_weight,\n",
    "                        \"validation_macro_f1\": val_f1, \"seconds\": time.perf_counter() - start})\n",
    "        print(f\"{name:8s} epoch {epoch:02d} | loss {history[-1]['training_loss']:.4f} | val macro F1 {val_f1:.4f}\")\n",
    "        if val_f1 > best_f1 + 1e-6:\n",
    "            best_f1, best_epoch, stale = val_f1, epoch, 0\n",
    "            best_state = {key: tensor.detach().cpu().clone() for key, tensor in model.state_dict().items()}\n",
    "        else:\n",
    "            stale += 1\n",
    "            if stale >= PATIENCE:\n",
    "                break\n",
    "    model.load_state_dict(best_state)\n",
    "    pred, scores = neural_predictions(model, make_loader(\"test\"))\n",
    "    return history, best_f1, best_epoch, pred, scores\n",
    "\n",
    "if EPOCHS < 1 or PATIENCE < 1:\n",
    "    raise ValueError(\"EPOCHS and PATIENCE must be at least 1.\")\n",
    "histories = []\n",
    "# Re-running this cell replaces neural results and retains classic results.\n",
    "results = [row for row in results if row[\"family\"] != \"Deep learning\"]\n",
