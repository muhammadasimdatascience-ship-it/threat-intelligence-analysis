    "    raise ValueError(\"Too little retained vocabulary for LDA. Increase data or reduce N_TOPICS/min_df.\")\n",
    "lda = LatentDirichletAllocation(n_components=N_TOPICS, max_iter=12, learning_method=\"batch\", random_state=SEED)\n",
